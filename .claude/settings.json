{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.secrets)",
      "Read(./.env.secrets.encrypted)",
      "Read(./private-keys/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)",
      "Read(./**/id_rsa.*)",
      "Read(./**/*.key)"
    ]
  }
}
