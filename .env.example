# Copy to .env at the repo root and fill in. `just` and Next.js both load this file.
# Secrets marked (encrypted) belong in .env.secrets.encrypted via `just enc KEY value`.

# ─── Deployment target ────────────────────────────────────────────────────────
# mainnet          — vault on Base with native USDC
# testnet          — vault on Sepolia with mock USDC
# botchain         — vault on BOT Chain mainnet (677)
# botchain-testnet — vault on BOT Chain testnet (968)
NEXT_PUBLIC_DEPLOY_TARGET=botchain-testnet

# ─── BOT Chain ────────────────────────────────────────────────────────────────
BOTCHAIN_RPC=https://rpc.botchain.ai
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
# Alias used by some Foundry/cast flows (same as DEPLOYER_PRIVATE_KEY)
PRIVATE_KEY=
# ─── Credit vault ─────────────────────────────────────────────────────────────
# Printed by `just deploy sepolia` / `just deploy base`.
CREDIT_VAULT_ADDRESS=
# Only used on testnet: address of the deployed mock USDC. On mainnet the vault
# token is pinned to Base native USDC and this is ignored.
CREDIT_USDC_ADDRESS=
CREDIT_DEPLOYMENT_BLOCK=
# RPC for the vault chain (Base on mainnet, Sepolia on testnet). HTTPS or loopback.
CREDIT_BASE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDIT_APP_ORIGIN=http://localhost:3000
CREDIT_CONFIRMATIONS=2
CREDIT_DATABASE_PATH=/absolute/path/to/credits.db
CREDIT_BILLING_SIGNER_PRIVATE_KEY=   # (encrypted) holds BILLING_ROLE on the vault
CREDIT_SCHEDULER_SECRET=             # at least 32 characters

# Deploy-time roles. On mainnet the admin MUST be a contract (multisig/timelock)
# and all three must be distinct — Deploy.s.sol enforces both.
CREDIT_ADMIN_ADDRESS=
CREDIT_BILLING_ADDRESS=
CREDIT_TREASURY_ADDRESS=

# ─── Uniswap Trading API ──────────────────────────────────────────────────────
USE_UNISWAP_API=true
UNISWAP_API_KEY=                     # (encrypted) from developer.uniswap.org
# Gateway endpoint. Developer Portal keys only work here, NOT on api.uniswap.org/v2.
UNISWAP_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
# Optional override. Defaults to the deploy target's chains: Ethereum (1),
# Base (8453), Robinhood Chain (4663), plus Sepolia on testnet.
# ALLOWED_TRADING_CHAINS=1,8453,4663
LEG_INTEGRATOR_FEE_RECIPIENT=        # receives the 10 bps integrator fee
# Per-chain RPC overrides, e.g. TRADING_RPC_URL_4663=https://...
# TRADING_RPC_URL_1=
TRADE_RECONCILER_SECRET=

# ─── 0G Compute Router ────────────────────────────────────────────────────────
# Base URL defaults to the deploy target's router; set only to override.
# Mainnet and testnet are fully separate: different endpoints, balances, API keys
# AND model catalogues, so the key and model must match the target.
#   mainnet  https://router-api.0g.ai/v1                       (pc.0g.ai)
#   testnet  https://router-api-testnet.integratenetwork.work/v1 (pc.testnet.0g.ai)
# ADVISOR_ROUTER_BASE_URL=
ADVISOR_ROUTER_API_KEY=              # (encrypted)
ADVISOR_ROUTER_MODEL=
ADVISOR_ROUTER_TIMEOUT_MS=45000
ADVISOR_ROUTER_MAX_COMPLETION_PRICE_MICRO_USDC_PER_MILLION=9000
ADVISOR_ROUTER_MAX_PROMPT_PRICE_MICRO_USDC_PER_MILLION=3000

# ─── Advisor pricing and data ─────────────────────────────────────────────────
ADVISOR_SCHEDULER_SECRET=
ADVISOR_PHILOSOPHY_VERSION=v1
ADVISOR_PRICE_VERSION=advisor-2026-07
ADVISOR_QUOTE_TTL_SECONDS=300
ADVISOR_COMPLETION_TOKEN_ALLOWANCE=1500
ADVISOR_MAX_PROMPT_TOKENS=24000
ADVISOR_MAX_TOOL_RESULT_TOKENS=6000
ADVISOR_FMP_MICRO_USDC=2500
ADVISOR_LEG_SERVICE_MICRO_USDC=5000
ADVISOR_FUNDAMENTALS_MAX_AGE_DAYS=200
ADVISOR_PRICE_MAX_AGE_SECONDS=900
ADVISOR_CONNECTOR_ISSUER_ORIGIN=http://localhost:3000
ADVISOR_CONNECTOR_AUTHORIZATION_CODE_TTL_SECONDS=120
ADVISOR_CONNECTOR_TOKEN_TTL_SECONDS=3600
FMP_API_KEY=                         # (encrypted)
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_COMMERCIAL_RIGHTS_REFERENCE=
FMP_PRODUCTION_LICENSE_CONFIRMED=false

# ─── Contract deployment ──────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=                # (encrypted)
DEPLOYER_ADDRESS=
AGENT_ADDRESS=
AGENT_PRIVATE_KEY=                   # (encrypted)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_AGENT_ADDRESS=
